#!/bin/sh
# ============================================================================
# LCARS-FimTale pre-commit guard (POSIX launcher)
# ============================================================================
# Used by git on macOS / Linux / Git Bash. On Windows, git prefers
# `pre-commit.bat`, which runs the same check.
#
# The working logic lives in check-secrets.js so both platforms behave the same.
# ============================================================================

HOOKDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v node >/dev/null 2>&1; then
	exec node "$HOOKDIR/check-secrets.js"
fi

printf '\nNOTE: Node.js was not found, so the credential guard did not run.\n'
printf '      Install Node.js to enable it. Proceeding without the guard.\n\n'
exit 0
